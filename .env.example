PORT=3000

# Where uploads/, outputs/, and jobs/ metadata are stored.
STORAGE_DIR=./storage

# Tesseract.js language data cache (pre-downloaded so the service can run
# fully offline; see README "OCR language data" section).
TESSDATA_DIR=./tessdata
OCR_LANGUAGE=eng
OCR_MIN_CONFIDENCE=40

# Concurrency
# Tesseract workers are CPU/memory heavy; 2 is the safe batch default.
WORKER_POOL_SIZE=2
IMAGE_PROCESSING_TIMEOUT_MS=180000
MAX_FILES_PER_JOB=1000
MAX_UPLOAD_FILE_SIZE_MB=25

# Matching heuristics - tune per carrier template if needed
MATCH_VERTICAL_WINDOW_RATIO=0.18
MATCH_HORIZONTAL_TOLERANCE_PX=120
ID_FUZZY_MAX_DISTANCE=1

JOB_RETENTION_HOURS=24
LOG_LEVEL=info
